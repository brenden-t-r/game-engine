// Fragment Shader
#version 330 core
in vec2 TexCoords;
out vec4 FragColor;

uniform sampler2D spriteTexture;

float median(float r, float g, float b) {
    return max(min(r, g), min(max(r, g), b));
}

float screenPxRange() {

    float pxRange = 30.0;

    vec2 unitRange = vec2(pxRange)/vec2(textureSize(spriteTexture, 0));
    vec2 screenTexSize = vec2(1.0)/fwidth(TexCoords);
    return max(0.5*dot(unitRange, screenTexSize), 1.0);
}

void main() {
    // Sample texture and multiply by color for tinting
    vec4 texColor = texture(spriteTexture, TexCoords);
    if (texColor.r ==0 && texColor.g == 0 && texColor.b == 0) {
        texColor.a = 0;
    }
    FragColor = texColor;

