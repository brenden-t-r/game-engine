// Fragment Shader
#version 330 core
in vec2 TexCoords;
out vec4 FragColor;

uniform sampler2D spriteTexture;

void main() {
    // Sample texture and multiply by color for tinting
    //vec4 texColor = texture(spriteTexture, TexCoords);
    //FragColor = texColor;


    vec4 texColor = texture(spriteTexture, TexCoords);
    float dist = texColor.r;
    float edge = 0.5;
    float smoothing = fwidth(dist);  // pixel-dependent width
    float alpha = smoothstep(edge - smoothing, edge + smoothing, dist);
    FragColor = vec4(0,0,0,alpha);
    //FragColor = texColor;
}

